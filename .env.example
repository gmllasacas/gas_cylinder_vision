# ==============================================================================
# Gas Tank Computer Vision Stream Counter - Environment Configuration (.env)
# ==============================================================================
# Machine-dependent settings that override config.json per installation host.

# ------------------------------------------------------------------------------
# 1. AI Inference Device / Hardware Acceleration
# Options:
#   - 'auto'   : Automatically selects CUDA GPU if PyTorch+CUDA is available, else CPU.
#   - 'cuda'   : Force CUDA execution on primary GPU (e.g. NVIDIA GeForce GTX 1660 Ti).
#   - 'cuda:0' : Specific GPU index in multi-GPU systems.
#   - 'cpu'    : Force multi-threaded CPU execution.
# ------------------------------------------------------------------------------
YOLO_DEVICE=auto

# ------------------------------------------------------------------------------
# 2. Web Server Network Binding
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Optional Machine-Specific IP Camera Override
# ------------------------------------------------------------------------------
# CAMERA_URL=rtsp://admin:password@192.168.1.100:554/stream1
