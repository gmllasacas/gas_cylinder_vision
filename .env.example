# Gas Stream Environment Variables Template
PORT=8000
HOST=0.0.0.0

# Source Configuration
SOURCE_TYPE=video
VIDEO_FILE=1min_test.mp4
CAMERA_URL=rtsp://admin:password@192.168.1.100:554/stream1
CAMERA_NAME="Warehouse IP Camera"
RECONNECT_INTERVAL_SEC=3

# Detector Tuning
DEFAULT_MODEL=best.pt
FALLBACK_MODEL=yolov8n.pt
CONFIDENCE=0.50
IMGSZ=640
FRAME_SKIP=2

# Streaming Output
OUTPUT_WIDTH=1024
JPEG_QUALITY=70
LANGUAGE=es
